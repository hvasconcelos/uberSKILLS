# Pin the Node.js version pnpm uses for install and scripts.
# This repo does not support Node 26+ (better-sqlite3 has no prebuilt binary
# for its ABI, and the dependency tree's engines allow 20.x-25.x only).
# pnpm auto-downloads and uses this version, so `pnpm install` / `pnpm dev`
# work regardless of the system or nvm default Node version.
use-node-version=22.23.1
